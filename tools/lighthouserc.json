{
  "ci": {
    "collect": {
      "staticDistDir": "conformance/public/ours",
      "url": [
        "http://localhost/index.html",
        "http://localhost/kitchen-sink/index.html",
        "http://localhost/kitchen-sink/links/index.html",
        "http://localhost/kitchen-sink/long/index.html",
        "http://localhost/kitchen-sink/code/index.html",
        "http://localhost/kitchen-sink/features/katex/index.html"
      ],
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--no-sandbox"
      }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": ".*/features/katex/.*",
          "assertions": {
            "categories:performance": [
              "error",
              {
                "minScore": 0.9
              }
            ],
            "categories:accessibility": [
              "error",
              {
                "minScore": 1
              }
            ],
            "categories:best-practices": [
              "error",
              {
                "minScore": 1
              }
            ],
            "categories:seo": [
              "error",
              {
                "minScore": 1
              }
            ],
            "resource-summary:total:size": [
              "error",
              {
                "maxNumericValue": 614400
              }
            ],
            "third-party-summary": [
              "error",
              {
                "maxLength": 0
              }
            ],
            "first-contentful-paint": [
              "error",
              {
                "maxNumericValue": 6000
              }
            ]
          },
          "aggregationMethod": "median"
        },
        {
          "matchingUrlPattern": "^(?!.*/features/katex/).*$",
          "assertions": {
            "categories:performance": [
              "error",
              {
                "minScore": 0.95
              }
            ],
            "categories:accessibility": [
              "error",
              {
                "minScore": 1
              }
            ],
            "categories:best-practices": [
              "error",
              {
                "minScore": 1
              }
            ],
            "categories:seo": [
              "error",
              {
                "minScore": 1
              }
            ],
            "resource-summary:total:size": [
              "error",
              {
                "maxNumericValue": 307200
              }
            ],
            "third-party-summary": [
              "error",
              {
                "maxLength": 0
              }
            ],
            "first-contentful-paint": [
              "error",
              {
                "maxNumericValue": 3000
              }
            ]
          },
          "aggregationMethod": "median"
        }
      ]
    }
  }
}
